<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!--
        m_fund ported verbatim from the monolith physical schema
        (fineract-provider .../db/changelog/tenant/parts/0001_initial_schema.xml, changeSet "69").
        The two unique constraints are named to match the JPA entity (fund_name_org, fund_externalid_org).
        This service owns its own database (fineract_fund); it does NOT touch the monolith schema.
    -->
    <changeSet author="fineract" id="fund-service-0001-1">
        <createTable tableName="m_fund">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="fund_name_org"/>
            </column>
            <column name="external_id" type="VARCHAR(100)">
                <constraints unique="true" uniqueConstraintName="fund_externalid_org"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
